    {
      "name": "1-Alur Utama",
      "description": "Skenario S01 sampai S15, dijalankan berurutan. Request POST menyimpan id baru ke environment lewat tab Tests (kategoriId, produkId, kategoriSementaraId). Nilai nama_kategori dan kode_produk memakai {{$timestamp}} supaya folder ini bisa dijalankan berulang kali pada database yang sudah diisi seed.",
      "item": [
        {
          "name": "S01 - POST /api/kategori",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('S01: status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('S01: respons sukses dan berisi id kategori', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('success');",
                  "  pm.expect(json.data.id).to.be.a('number');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('kategoriId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/kategori",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "kategori"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_kategori\": \"Kategori Uji {{$timestamp}}\",\n  \"deskripsi\": \"Kategori untuk pengujian\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
